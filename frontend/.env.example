# Copy this file to frontend/.env and adjust the values if needed.
# The defaults below are what the app uses when no .env file exists.
#
# IMPORTANT: every variable starting with VITE_ is bundled into the
# JavaScript sent to the browser and can be read by anyone. Never put an API
# key, password, JWT secret or any other secret in a VITE_ variable.
# Private keys (e.g. the chatbot's AI provider key) belong in the backend's
# own environment file.

# Base URL of the backend REST API, as seen from the browser.
# Leave as /api for local development (the Vite dev server proxies it).
# For a deployed backend use its public URL, e.g. https://api.example.com/api
VITE_API_BASE_URL=/api

# Set to true to run with built-in sample data instead of the backend
# (same as "npm run demo"). Not a secret: it only switches demo mode on.
VITE_DEMO_MODE=false

# Where the Vite dev server forwards /api requests during `npm run dev`.
# Not exposed to the browser (no VITE_ prefix).
API_PROXY_TARGET=http://localhost:5000
