# copy to backend/.env and fill in your values

# database (sql express: DB_SERVER=localhost\SQLEXPRESS)
DB_SERVER=localhost
DB_DATABASE=TravelBookingDB
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_PORT=1433
DB_OPTIONS={"encrypt":false,"trustServerCertificate":true}

# use a long random secret
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

PORT=5000

# empty = allow any origin
CORS_ORIGIN=

# leave AI_API_KEY empty to switch the chatbot off
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
