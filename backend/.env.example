# Copy this file to backend/.env and fill in your own values.
# backend/.env is in .gitignore and must never be uploaded to GitHub.

# SQL Server connection
# For SQL Server Express use: DB_SERVER=localhost\SQLEXPRESS
DB_SERVER=localhost
DB_DATABASE=TravelBookingDB
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_PORT=1433
DB_OPTIONS={"encrypt":false,"trustServerCertificate":true}

# Login tokens. Use a long random value (at least 32 characters). Make one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

PORT=5000

# Which website address may call the API. Empty = allow any (fine for local use).
# Example: CORS_ORIGIN=http://localhost:3000
CORS_ORIGIN=

# Chatbot AI provider (any OpenAI-compatible service).
# Leave AI_API_KEY empty to keep the chatbot switched off.
# Check each provider's site for current free limits and model names.
#
# Groq:        AI_BASE_URL=https://api.groq.com/openai/v1
# OpenRouter:  AI_BASE_URL=https://openrouter.ai/api/v1   (pick a model ending in ":free")
# Gemini:      AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Ollama:      AI_BASE_URL=http://localhost:11434/v1     (runs on your PC, no key needed)
# OpenAI:      leave AI_BASE_URL empty
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
